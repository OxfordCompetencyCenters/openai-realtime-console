OPENAI_API_KEY="<your-key-here>"
JWKS_URI="http://localhost:8080/.well-known/jwks.json"
CANVAS_ISSUER="https://canvas.yourinstitution.edu"
CANVAS_AUTHORIZATION_ENDPOINT="https://canvas.yourinstitution.edu/api/lti/authorize_redirect"
